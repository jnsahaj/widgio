{
  "name": "widgio",
  "version": "0.1.3",
  "description": "Stream animated SVG/HTML widgets from terminal agents to a browser companion",
  "keywords": [
    "widget",
    "svg",
    "diagram",
    "agent",
    "claude",
    "codex",
    "visual"
  ],
  "author": "Sahaj Jain",
  "license": "MIT",
  "homepage": "https://github.com/jnsahaj/widgio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnsahaj/widgio.git"
  },
  "type": "module",
  "bin": {
    "widgio": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "tsx watch src/cli/index.ts",
    "start:server": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "test -d dist || tsx scripts/build.ts",
    "prepublishOnly": "tsx scripts/build.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "open": "^10.1.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
